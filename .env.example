# ─────────────────────────────────────────────
# Meta Ad Library API
# ─────────────────────────────────────────────
# Get your token at: https://developers.facebook.com/tools/explorer/
# Required permissions: ads_read
META_ACCESS_TOKEN=your_meta_access_token_here

# ─────────────────────────────────────────────
# Slack App
# ─────────────────────────────────────────────
# Create a Slack App at: https://api.slack.com/apps
# Required scopes: files:write, chat:write, channels:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Channel IDs (right-click channel in Slack → Copy Link → last part is the ID)
SLACK_VIDEO_CHANNEL=C0XXXXXXXXX
SLACK_STATIC_CHANNEL=C0YYYYYYYYY

# ─────────────────────────────────────────────
# Settings
# ─────────────────────────────────────────────
# How many hours back to look for new ads (default: 48)
LOOKBACK_HOURS=48

# Daily run time in 24h format (default: 06:00)
RUN_TIME=06:00
